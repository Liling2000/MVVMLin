<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f7f9"
        android:orientation="vertical">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_f6f7f9"
            app:tit_text="@string/device_setting_title" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="6dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

            <com.aleyn.mvvm.widget.MyInformationView
                    android:id="@+id/row_charge_mode"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_device_setting_card"
                    app:is_show_arrow_right="true"
                    app:left_text="@string/device_setting_charge_mode"
                    app:left_text_size="16sp"
                    app:right_arrow_icon="@mipmap/ic_chevron_right"
                    app:right_text="@string/device_setting_smart_mode"
                    app:right_text_size="16sp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_device_setting_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/row_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        app:is_show_arrow_right="true"
                        app:is_show_line="true"
                        app:left_text="@string/device_setting_device_name"
                        app:left_text_size="16sp"
                        app:right_arrow_icon="@mipmap/ic_mb_modify"
                        app:right_text="@string/device_setting_default_name"
                        app:right_text_size="16sp" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/row_model"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/device_setting_model"
                        app:left_text_size="16sp"
                        app:right_text="@string/device_setting_model_value"
                        app:right_text_size="16sp" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/row_certification"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        app:is_show_arrow_right="true"
                        app:is_show_line="true"
                        app:left_text="@string/device_setting_certification"
                        app:left_text_size="16sp"
                        app:right_arrow_icon="@mipmap/ic_chevron_right"
                        app:right_text="@string/device_setting_certification_value"
                        app:right_text_size="16sp" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/row_serial_number"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/device_setting_serial_number"
                        app:left_text_size="16sp"
                        app:right_text="@string/device_setting_serial_number_value"
                        app:right_text_size="16sp" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/row_factory_reset"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        app:is_show_arrow_right="true"
                        app:left_text="@string/device_setting_factory_reset"
                        app:left_text_size="16sp"
                        app:right_arrow_icon="@mipmap/ic_chevron_right" />
            </LinearLayout>

            <TextView
                    android:id="@+id/button_delete_device"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_device_setting_delete"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/device_setting_delete"
                    android:textColor="@color/color_e62e2e"
                    android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
