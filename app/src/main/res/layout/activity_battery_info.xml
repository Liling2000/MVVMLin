<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f7f9">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_f6f7f9"
            app:layout_constraintTop_toTopOf="parent"
            app:right_icon="@mipmap/ic_common_history"
            app:tit_text="@string/battery_info_title" />

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="36dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="14dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/battery_health"
                            android:textColor="@color/color_17181c"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/text_health_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_health_excellent"
                            android:textColor="@color/color_12b82f"
                            android:textSize="14sp" />

                    <TextView
                            android:id="@+id/text_health_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/color_12b82f"
                            android:textSize="14sp" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="18dp">

                    <ProgressBar
                            android:id="@+id/progress_health"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_battery_health"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline_health_65"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.65" />

                    <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline_health_80"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.80" />

                    <View
                            android:layout_width="2dp"
                            android:layout_height="12dp"
                            android:background="@color/color_ffffff"
                            app:layout_constraintEnd_toEndOf="@id/guideline_health_65"
                            app:layout_constraintStart_toStartOf="@id/guideline_health_65"
                            app:layout_constraintTop_toTopOf="@id/progress_health" />

                    <View
                            android:layout_width="2dp"
                            android:layout_height="12dp"
                            android:background="@color/color_ffffff"
                            app:layout_constraintEnd_toEndOf="@id/guideline_health_80"
                            app:layout_constraintStart_toStartOf="@id/guideline_health_80"
                            app:layout_constraintTop_toTopOf="@id/progress_health" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_health_threshold_65"
                            android:textColor="@color/color_a5a6aa"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/guideline_health_65"
                            app:layout_constraintStart_toStartOf="@id/guideline_health_65"
                            app:layout_constraintTop_toBottomOf="@id/progress_health" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_health_threshold_80"
                            android:textColor="@color/color_a5a6aa"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/guideline_health_80"
                            app:layout_constraintStart_toStartOf="@id/guideline_health_80"
                            app:layout_constraintTop_toBottomOf="@id/progress_health" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_healthy_desc"
                        android:textColor="@color/color_a5a6aa"
                        android:textSize="12sp" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/color_e7eaf0" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/battery_cycle_count"
                            android:textColor="@color/color_17181c"
                            android:textSize="16sp" />

                    <TextView
                            android:id="@+id/text_health_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_55596a"
                            android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_manufacturer"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_manufacturer" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_model"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:left_text="@string/battery_model" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_cycle"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_cycle_count" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_recommended"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:left_text="@string/battery_recommended_time" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_series"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_series" />

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_cells"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_rated_power"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_rated_power" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_max_charge"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_max_charge_power" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_max_discharge"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:left_text="@string/battery_max_discharge_power" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_battery_card"
                    android:orientation="vertical">

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_discharge_time"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:is_show_line="true"
                        app:left_text="@string/battery_total_discharge_time" />

                <com.aleyn.mvvm.widget.MyInformationView
                        android:id="@+id/info_discharge_capacity"
                        style="@style/BatteryInformationRow"
                        app:is_show_arrow_right="false"
                        app:left_text="@string/battery_total_discharge_capacity" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
