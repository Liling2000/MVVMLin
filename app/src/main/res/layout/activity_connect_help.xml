<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f8fa"
        android:orientation="vertical"
        tools:context=".app.ConnectHelpActivity">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_f6f8fa"
            app:left_icon="@mipmap/ic_back"
            app:tit_text="@string/help_title" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

            <LinearLayout style="@style/HelpStepRow">

                <TextView
                        style="@style/HelpStepNumber"
                        android:text="@string/help_step_number_1" />

                <TextView
                        style="@style/HelpStepText"
                        android:text="@string/help_step_1" />
            </LinearLayout>

            <LinearLayout
                    style="@style/HelpStepRow"
                    android:layout_marginTop="18dp">

                <TextView
                        style="@style/HelpStepNumber"
                        android:text="@string/help_step_number_2" />

                <TextView
                        style="@style/HelpStepText"
                        android:text="@string/help_step_2" />
            </LinearLayout>

            <LinearLayout
                    style="@style/HelpStepRow"
                    android:layout_marginTop="18dp">

                <TextView
                        style="@style/HelpStepNumber"
                        android:text="@string/help_step_number_3" />

                <TextView
                        style="@style/HelpStepText"
                        android:text="@string/help_step_3" />
            </LinearLayout>

            <LinearLayout
                    style="@style/HelpStepRow"
                    android:layout_marginTop="18dp">

                <TextView
                        style="@style/HelpStepNumber"
                        android:text="@string/help_step_number_4" />

                <TextView
                        style="@style/HelpStepText"
                        android:text="@string/help_step_4" />
            </LinearLayout>

            <LinearLayout
                    style="@style/HelpStepRow"
                    android:layout_marginTop="18dp">

                <TextView
                        style="@style/HelpStepNumber"
                        android:text="@string/help_step_number_5" />

                <TextView
                        style="@style/HelpStepText"
                        android:text="@string/help_step_5" />
            </LinearLayout>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/help_note"
                    android:textColor="@color/color_9295a2"
                    android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
