<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f6f7f9">

    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/error_toolbar_height"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/error_toolbar_height"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/error_back"
            android:padding="@dimen/dp_20"
            android:src="@mipmap/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/error_page_title"
            android:textColor="@color/color_17181c"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/page_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/error_page_margin"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/error_page_margin"
        android:text="@string/error_history_description"
        android:textColor="@color/color_77798d"
        android:textSize="@dimen/sp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/error_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/error_page_margin"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginEnd="@dimen/error_page_margin"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_description" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_empty"
        android:textColor="@color/color_9295a2"
        android:textSize="@dimen/sp_16"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_description" />

</androidx.constraintlayout.widget.ConstraintLayout>
