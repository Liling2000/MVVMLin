<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f7f9"

        android:orientation="vertical">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:right_icon="@mipmap/ic_settings_filled"
            app:tit_text="@string/power_page_title" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="0dp"
                android:paddingEnd="24dp"
                android:paddingBottom="36dp">

            <FrameLayout
                    android:layout_width="184dp"
                    android:layout_height="184dp"
                    android:layout_marginTop="4dp">

                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_device_time_bg" />

                <com.aleyn.mvvm.widget.ContentWithUnitTextView
                        android:id="@+id/text_battery_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:tv_content="78"
                        app:tv_content_color="@color/color_191c1e"
                        app:tv_content_size="48sp"
                        app:tv_unit="%"
                        app:tv_unit_color="@color/color_191c1e"
                        app:tv_unit_size="20sp" />
            </FrameLayout>

            <TextView
                    android:id="@+id/text_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/color_77798d"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="@string/power_preview_remaining" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_power_temperature"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_temperature" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/power_temperature"
                        android:textColor="@color/color_77798d"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/text_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:textColor="@color/color_191c1e"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="@string/power_preview_temperature" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                <include
                        android:id="@+id/card_c1"
                        layout="@layout/item_power_port" />

                <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                <include
                        android:id="@+id/card_c2"
                        layout="@layout/item_power_port" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                <include
                        android:id="@+id/card_c3"
                        layout="@layout/item_power_port" />

                <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                <include
                        android:id="@+id/card_a1"
                        layout="@layout/item_power_port" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/card_port_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="20dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/tab_c1"
                            style="@style/PowerPortTab"
                            android:text="@string/power_port_c1" />

                    <TextView
                            android:id="@+id/tab_c2"
                            style="@style/PowerPortTab"
                            android:layout_marginStart="10dp"
                            android:text="@string/power_port_c2" />

                    <TextView
                            android:id="@+id/tab_c3"
                            style="@style/PowerPortTab"
                            android:layout_marginStart="10dp"
                            android:text="@string/power_port_c3" />

                    <TextView
                            android:id="@+id/tab_a1"
                            style="@style/PowerPortTab"
                            android:layout_marginStart="10dp"
                            android:text="@string/power_port_a1" />
                </LinearLayout>

                <include
                        android:id="@+id/detail_cable"
                        layout="@layout/item_power_detail" />

                <include
                        android:id="@+id/detail_protocol"
                        layout="@layout/item_power_detail" />

                <include
                        android:id="@+id/detail_model"
                        layout="@layout/item_power_detail" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp">

                <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_lightning" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/power_low_current_mode"
                        android:textColor="@color/color_77798d"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <com.aleyn.mvvm.widget.SwitchButtonKotlin
                        android:id="@+id/switch_low_current"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        app:sb_checkedColor="@color/color_0752ae"
                        app:sb_enableEffect="true"
                        app:sb_thumbColor="@color/color_ffffff"
                        app:sb_un_thumbColor="@color/color_ffffff"
                        app:sb_uncheckedColor="@color/color_c4c7cd" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/button_screen_settings"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp">

                <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_settings_outline" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/power_screen_settings"
                        android:textColor="@color/color_77798d"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <ImageView
                        android:layout_width="72dp"
                        android:layout_height="52dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_mobile_theme_three_pre" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/card_battery_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="24dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/power_battery_info"
                            android:textColor="@color/color_191c1e"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    <ImageView
                            android:layout_width="16dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@mipmap/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <FrameLayout
                            android:layout_width="104dp"
                            android:layout_height="104dp">

                        <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@mipmap/ic_device_info_bg" />

                        <com.aleyn.mvvm.widget.ContentWithUnitTextView
                                android:id="@+id/text_battery_health"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                app:tv_content="100"
                                app:tv_content_color="@color/color_191c1e"
                                app:tv_content_size="24sp"
                                app:tv_unit="%"
                                app:tv_unit_color="@color/color_191c1e"
                                app:tv_unit_size="14sp" />
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="34dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <include
                                android:id="@+id/detail_cycle_count"
                                layout="@layout/item_power_battery_detail" />

                        <include
                                android:id="@+id/detail_capacity"
                                layout="@layout/item_power_battery_detail" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
