<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f7f9fb"

        android:orientation="vertical">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:right_icon="@mipmap/ic_settings_filled"
            app:tit_text="@string/power_main_title" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="0dp"
                android:paddingEnd="24dp"
                android:paddingBottom="36dp">

            <FrameLayout
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:layout_marginTop="4dp">

                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_power_battery_ring" />

                <com.aleyn.mvvm.widget.ContentWithUnitTextView
                        android:id="@+id/text_battery_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        tools:tv_content="78"
                        app:tv_content_color="@color/color_191c1e"
                        app:tv_content_size="46sp"
                        app:tv_unit="@string/power_unit_percent"
                        app:tv_unit_color="@color/color_191c1e"
                        app:tv_unit_size="20sp" />
            </FrameLayout>

            <TextView
                    android:id="@+id/text_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/color_77798d"
                    android:textSize="12sp"
                    tools:text="@string/power_preview_remaining" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_power_temperature"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_temperature" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/power_temperature"
                        android:textColor="@color/color_77798d"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/text_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:textColor="@color/color_191c1e"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="@string/power_preview_temperature" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                <include
                        android:id="@+id/card_c1"
                        layout="@layout/item_power_port" />

                <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                <include
                        android:id="@+id/card_c2"
                        layout="@layout/item_power_port" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                <include
                        android:id="@+id/card_a1"
                        layout="@layout/item_power_port" />

                <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                <View
                        android:layout_width="0dp"
                        android:layout_height="125dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_power_port_placeholder" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/card_port_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="20dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_power_chip_normal"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/tab_c1"
                            style="@style/PowerPortTab"
                            android:text="@string/power_port_c1" />

                    <TextView
                            android:id="@+id/tab_c2"
                            style="@style/PowerPortTab"
                            android:text="@string/power_port_c2" />

                    <TextView
                            android:id="@+id/tab_a1"
                            style="@style/PowerPortTab"
                            android:text="@string/power_port_tab_a1" />
                </LinearLayout>

                <include
                        android:id="@+id/detail_cable"
                        layout="@layout/item_power_detail" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/color_f7f9fb" />

                <include
                        android:id="@+id/detail_protocol"
                        layout="@layout/item_power_detail" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/color_f7f9fb" />

                <include
                        android:id="@+id/detail_model"
                        layout="@layout/item_power_detail" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp">

                <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_lightning" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/power_low_current_mode"
                        android:textColor="@color/color_77798d"
                        android:textSize="15sp" />

                <com.aleyn.mvvm.widget.SwitchButtonKotlin
                        android:id="@+id/switch_low_current"
                        android:layout_width="48dp"
                        android:layout_height="26dp"
                        app:sb_checkedColor="@color/color_004098"
                        app:sb_thumbColor="@color/color_ffffff"
                        app:sb_uncheckedColor="@color/color_d7dce2" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/button_screen_settings"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp">

                <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_settings_outline" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/power_screen_settings"
                        android:textColor="@color/color_77798d"
                        android:textSize="15sp" />

                <ImageView
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_mobile_theme_three_pre" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/card_battery_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_power_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="24dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/power_battery_info"
                            android:textColor="@color/color_77798d"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    <ImageView
                            android:layout_width="16dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@mipmap/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="94dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                        <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@mipmap/ic_device_info_bg"
                                app:tint="@color/color_28c335" />

                        <com.aleyn.mvvm.widget.ContentWithUnitTextView
                                android:id="@+id/text_battery_health"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                tools:tv_content="100"
                                app:tv_content_color="@color/color_28c335"
                                app:tv_content_size="20sp"
                                app:tv_unit="@string/power_unit_percent"
                                app:tv_unit_color="@color/color_28c335"
                                app:tv_unit_size="14sp" />
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="34dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <include
                                android:id="@+id/detail_cycle_count"
                                layout="@layout/item_power_battery_detail" />

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_f7f9fb" />

                        <include
                                android:id="@+id/detail_capacity"
                                layout="@layout/item_power_battery_detail" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
