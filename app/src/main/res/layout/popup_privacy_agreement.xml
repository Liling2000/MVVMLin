<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/popup_privacy_height"
    android:background="@drawable/bg_popup_container"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_privacy_horizontal_padding"
    android:paddingTop="@dimen/popup_privacy_top_padding"
    android:paddingEnd="@dimen/popup_privacy_horizontal_padding"
    android:paddingBottom="@dimen/popup_privacy_bottom_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/popup_privacy_title"
        android:textColor="@color/color_17181c"
        android:textSize="@dimen/popup_request_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/agreement_introduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_privacy_intro_margin"
        android:lineSpacingExtra="@dimen/popup_line_spacing"
        android:textColor="@color/color_333333"
        android:textSize="@dimen/popup_body_text_size" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/popup_privacy_body_margin"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/popup_privacy_line_spacing"
            android:text="@string/popup_privacy_body"
            android:textColor="@color/color_a0a0ab"
            android:textSize="@dimen/popup_privacy_body_text_size" />
    </ScrollView>

    <TextView
        android:id="@+id/agree_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/popup_button_height"
        android:layout_marginTop="@dimen/popup_privacy_button_margin"
        android:background="@drawable/bg_popup_button_primary"
        android:gravity="center"
        android:text="@string/popup_agree"
        android:textColor="@color/color_ffffff"
        android:textSize="@dimen/popup_button_text_size" />

    <TextView
        android:id="@+id/disagree_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/popup_text_button_height"
        android:layout_marginTop="@dimen/popup_disagree_margin"
        android:gravity="center"
        android:text="@string/popup_disagree"
        android:textColor="@color/color_a0a0ab"
        android:textSize="@dimen/popup_body_text_size" />
</LinearLayout>
