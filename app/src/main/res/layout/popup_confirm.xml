<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_container"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_horizontal_padding"
    android:paddingTop="@dimen/popup_confirm_top_padding"
    android:paddingEnd="@dimen/popup_horizontal_padding"
    android:paddingBottom="@dimen/popup_confirm_bottom_padding">

    <TextView
        android:id="@+id/popup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/color_17181c"
        android:textSize="@dimen/popup_title_text_size" />

    <TextView
        android:id="@+id/popup_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_message_margin_top"
        android:gravity="center"
        android:textColor="@color/color_777b8d"
        android:textSize="@dimen/popup_body_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/popup_button_height"
        android:layout_marginTop="@dimen/popup_confirm_buttons_margin_top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/popup_button_gap_half"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_button_secondary"
            android:gravity="center"
            android:text="@string/popup_cancel"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/popup_button_text_size" />

        <TextView
            android:id="@+id/positive_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/popup_button_gap_half"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_button_primary"
            android:gravity="center"
            android:textColor="@color/color_ffffff"
            android:textSize="@dimen/popup_button_text_size" />
    </LinearLayout>
</LinearLayout>
