<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.aleyn.mvvm.widget.ComToolBar
        android:id="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/c_ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tit_text="@string/str_bs_choose_time" />

    <LinearLayout
        android:id="@+id/layout_offline_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <include layout="@layout/include_layout_offline_tip" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_des_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_bs_choose_time"
        app:layout_constraintTop_toBottomOf="@+id/layout_offline_tip"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginStart="@dimen/dp20"
        android:textColor="@color/c_181a20"
        android:textSize="@dimen/dp16"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_time_choose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_des_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"
        />

    <TextView
        android:id="@+id/tv_sure"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp54"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp29"
        android:background="@drawable/button_selector"
        android:enabled="false"
        android:gravity="center"
        android:text="@string/str_confirm"
        android:textColor="@color/color_181a20_b6b8c0"
        android:textSize="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
