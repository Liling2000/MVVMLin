<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/error_card_spacing"
    android:background="@drawable/bg_error_record_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:elevation="1dp"
    android:minHeight="@dimen/error_card_min_height"
    android:paddingStart="28dp"
    android:paddingEnd="16dp"
    android:paddingVertical="20dp">

    <ImageView
        android:id="@+id/error_icon"
        android:layout_width="@dimen/error_icon_size"
        android:layout_height="@dimen/error_icon_size"
        android:importantForAccessibility="no"
        app:tint="@color/color_757589"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/error_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/color_191c1e"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/error_arrow"
        app:layout_constraintStart_toEndOf="@id/error_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/error_arrow"
        android:layout_width="12dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_s_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>