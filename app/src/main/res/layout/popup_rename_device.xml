<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_container"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_horizontal_padding"
    android:paddingTop="@dimen/popup_confirm_top_padding"
    android:paddingEnd="@dimen/popup_horizontal_padding"
    android:paddingBottom="@dimen/popup_confirm_bottom_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/device_setting_edit_name_title"
        android:textColor="@color/color_191c1e"
        android:textSize="@dimen/popup_title_text_size" />

    <EditText
        android:id="@+id/name_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_popup_name_input"
        android:gravity="center_vertical"
        android:hint="@string/device_setting_name_hint"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLength="10"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:selectAllOnFocus="true"
        android:textColor="@color/color_191c1e"
        android:textColorHint="@color/color_a0a0ab"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/name_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="5dp"
        android:text="@string/device_setting_name_empty"
        android:textColor="@color/color_e62e2e"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/popup_button_height"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/popup_button_gap_half"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_button_secondary"
            android:gravity="center"
            android:text="@string/device_setting_cancel"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/popup_button_text_size" />

        <TextView
            android:id="@+id/confirm_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/popup_button_gap_half"
            android:layout_weight="1"
            android:background="@drawable/bg_popup_button_primary"
            android:gravity="center"
            android:text="@string/device_setting_confirm"
            android:textColor="@color/color_ffffff"
            android:textSize="@dimen/popup_button_text_size" />
    </LinearLayout>
</LinearLayout>
