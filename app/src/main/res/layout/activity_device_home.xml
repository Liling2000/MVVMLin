<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/device_page_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_410"
                android:background="@drawable/bg_device_header">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_15">

                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_24"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/device_home_status_bar" />

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginTop="@dimen/dp_8">

                    <ImageButton
                            android:id="@+id/iv_back"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:layout_gravity="center_vertical|start"
                            android:background="@drawable/bg_device_toolbar_button"
                            android:contentDescription="@null"
                            android:padding="@dimen/dp_10"
                            android:scaleType="centerInside"
                            android:src="@mipmap/device_home_back" />

                    <TextView
                            android:id="@+id/tv_device_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/device_text_primary"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold" />

                    <ImageButton
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:layout_gravity="center_vertical|end"
                            android:background="@drawable/bg_device_toolbar_button"
                            android:contentDescription="@null"
                            android:padding="@dimen/dp_10"
                            android:scaleType="centerInside"
                            android:src="@mipmap/device_home_settings" />
                </FrameLayout>

                <ImageView
                        android:layout_width="@dimen/dp_240"
                        android:layout_height="@dimen/dp_165"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/dp_12"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/device_home_headphones_product" />

                <TextView
                        android:id="@+id/tv_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/dp_10"
                        android:textColor="@color/device_text_primary"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tv_connection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/dp_4"
                        android:textColor="@color/device_text_secondary"
                        android:textSize="@dimen/sp_12" />

                <RadioGroup
                        android:id="@+id/mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_64"
                        android:layout_marginTop="@dimen/dp_18"
                        android:background="@drawable/bg_device_mode_container"
                        android:checkedButton="@id/rb_mode_normal"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/dp_4">

                    <RadioButton
                            android:id="@+id/rb_mode_normal"
                            style="@style/DeviceHomeModeRadio"
                            android:drawableTop="@mipmap/device_home_noise_normal"
                            android:text="正常" />

                    <RadioButton
                            android:id="@+id/rb_mode_transparency"
                            style="@style/DeviceHomeModeRadio"
                            android:drawableTop="@mipmap/device_home_noise_transparency"
                            android:text="通透" />

                    <RadioButton
                            android:id="@+id/rb_mode_anc"
                            style="@style/DeviceHomeModeRadio"
                            android:drawableTop="@mipmap/device_home_noise_cancellation"
                            android:text="降噪" />
                </RadioGroup>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"
                android:paddingBottom="@dimen/dp_28">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginTop="@dimen/dp_14"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_device_banner"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/device_home_ximalaya_banner" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_96"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="horizontal">

                <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/dp_6"
                        android:layout_weight="1"
                        android:background="@drawable/bg_device_ai_translate"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/dp_18">

                    <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/device_home_ai_translate" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:text="AI翻译"
                            android:textColor="@color/device_text_primary"
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_weight="1"
                        android:background="@drawable/bg_device_ai_record"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/dp_18">

                    <ImageView
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/device_home_ai_recording" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:text="AI录音"
                            android:textColor="@color/device_text_primary"
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/bg_device_card"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_16">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_42"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_20"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/device_home_dolby" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_10"
                            android:text="Dolby 音效"
                            android:textColor="@color/device_text_primary"
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/tv_dolby_state"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:paddingEnd="@dimen/dp_10"
                            android:textColor="@color/device_text_secondary"
                            android:textSize="@dimen/sp_12" />

                    <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_dolby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/dp_48"
                            android:showText="false" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_82"
                        android:layout_marginTop="@dimen/dp_12"
                        android:background="@drawable/bg_device_sub_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16">

                    <ImageView
                            android:layout_width="@dimen/dp_34"
                            android:layout_height="@dimen/dp_34"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/device_home_eq" />

                    <LinearLayout
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EQ"
                                android:textColor="@color/device_text_primary"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_6"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="清澈人声清澈人声清澈人声"
                                android:textColor="@color/device_text_secondary"
                                android:textSize="@dimen/sp_12" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                        style="@style/DeviceHomeIconRow"
                        android:layout_marginTop="@dimen/dp_10">

                    <ImageView
                            style="@style/DeviceHomeRowIcon"
                            android:src="@mipmap/device_home_sound_personalization" />

                    <TextView
                            style="@style/DeviceHomeRowText"
                            android:text="声音个性化" />
                </LinearLayout>

                <LinearLayout
                        style="@style/DeviceHomeIconRow"
                        android:layout_marginTop="@dimen/dp_10">

                    <ImageView
                            style="@style/DeviceHomeRowIcon"
                            android:src="@mipmap/device_home_sound_settings" />

                    <TextView
                            style="@style/DeviceHomeRowText"
                            android:text="声音设置" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_features"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>