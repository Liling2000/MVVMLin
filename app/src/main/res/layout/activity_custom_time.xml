<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f7f9">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_f6f7f9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tit_text="@string/custom_time_title" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/custom_time_page_margin"
            android:paddingEnd="@dimen/custom_time_page_margin"
            app:layout_constraintBottom_toTopOf="@id/button_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/text_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_0752ae"
                    android:textSize="@dimen/custom_time_value_size"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/custom_time_unit_margin"
                    android:layout_marginBottom="@dimen/custom_time_unit_bottom_margin"
                    android:text="@string/custom_time_hour"
                    android:textColor="@color/color_45475a"
                    android:textSize="@dimen/custom_time_unit_size" />

            <TextView
                    android:id="@+id/text_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/custom_time_value_gap"
                    android:textColor="@color/color_0752ae"
                    android:textSize="@dimen/custom_time_value_size"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/custom_time_unit_margin"
                    android:layout_marginBottom="@dimen/custom_time_unit_bottom_margin"
                    android:text="@string/custom_time_minute"
                    android:textColor="@color/color_45475a"
                    android:textSize="@dimen/custom_time_unit_size" />
        </LinearLayout>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/custom_time_hint_margin_top"
                android:text="@string/custom_time_hint"
                android:textColor="@color/color_9a9da7"
                android:textSize="@dimen/custom_time_hint_size" />

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/custom_time_picker_card_height"
                android:layout_marginTop="@dimen/custom_time_picker_margin_top"
                android:background="@drawable/bg_custom_time_picker_card"
                android:elevation="@dimen/custom_time_card_elevation"
                android:paddingStart="@dimen/custom_time_picker_padding"
                android:paddingEnd="@dimen/custom_time_picker_padding">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/custom_time_picker_header_height"
                        android:gravity="center"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/custom_time_hour"
                            android:textColor="@color/color_191c1e"
                            android:textSize="@dimen/custom_time_picker_label_size"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/custom_time_minute"
                            android:textColor="@color/color_191c1e"
                            android:textSize="@dimen/custom_time_picker_label_size"
                            android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/custom_time_indicator_height"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_custom_time_selection"
                            android:importantForAccessibility="no" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                        <com.base.baseus.widget.wheelview.PickWheelView
                                android:id="@+id/hour_picker"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                app:wv_curved="false"
                                app:wv_cyclic="false"
                                app:wv_lineSpacing="@dimen/custom_time_wheel_line_spacing"
                                app:wv_normalTextColor="@color/color_9a9da7"
                                app:wv_refractRatio="0.62"
                                app:wv_selectedTextColor="@color/color_0752ae"
                                app:wv_selectedTextFakeBold="true"
                                app:wv_textSize="@dimen/custom_time_wheel_text_size"
                                app:wv_visibleItems="5" />

                        <View
                                android:layout_width="@dimen/custom_time_picker_divider_width"
                                android:layout_height="match_parent"
                                android:background="@color/color_eef0f3" />

                        <com.base.baseus.widget.wheelview.PickWheelView
                                android:id="@+id/minute_picker"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                app:wv_curved="false"
                                app:wv_cyclic="false"
                                app:wv_lineSpacing="@dimen/custom_time_wheel_line_spacing"
                                app:wv_normalTextColor="@color/color_9a9da7"
                                app:wv_refractRatio="0.62"
                                app:wv_selectedTextColor="@color/color_0752ae"
                                app:wv_selectedTextFakeBold="true"
                                app:wv_textSize="@dimen/custom_time_wheel_text_size"
                                app:wv_visibleItems="5" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/custom_time_preset_title_margin"
                android:text="@string/custom_time_quick_preset"
                android:textColor="@color/color_9a9da7"
                android:textSize="@dimen/custom_time_hint_size" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/custom_time_preset_height"
                android:layout_marginTop="@dimen/custom_time_preset_margin"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/button_add_15"
                    style="@style/CustomTimePreset"
                    android:text="@string/custom_time_add_15" />

            <TextView
                    android:id="@+id/button_add_30"
                    style="@style/CustomTimePreset"
                    android:layout_marginStart="@dimen/custom_time_preset_gap"
                    android:text="@string/custom_time_add_30" />

            <TextView
                    android:id="@+id/button_add_hour"
                    style="@style/CustomTimePreset"
                    android:layout_marginStart="@dimen/custom_time_preset_gap"
                    android:text="@string/custom_time_add_hour" />

            <TextView
                    android:id="@+id/button_reset"
                    style="@style/CustomTimePreset"
                    android:layout_marginStart="@dimen/custom_time_preset_gap"
                    android:text="@string/custom_time_reset" />
        </LinearLayout>
    </LinearLayout>

    <TextView
            android:id="@+id/button_confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/custom_time_confirm_height"
            android:layout_marginStart="@dimen/custom_time_page_margin"
            android:layout_marginEnd="@dimen/custom_time_page_margin"
            android:layout_marginBottom="@dimen/custom_time_confirm_bottom_margin"
            android:background="@drawable/bg_custom_time_confirm"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/custom_time_confirm"
            android:textColor="@color/color_ffffff"
            android:textSize="@dimen/custom_time_confirm_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
