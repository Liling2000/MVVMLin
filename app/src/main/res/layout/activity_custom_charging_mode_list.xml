<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/custom_mode_page_background"
        android:orientation="vertical">

    <com.aleyn.mvvm.widget.ComToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/custom_mode_page_background"
            app:tit_text="@string/custom_mode_list_title" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_modes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp" />

    <TextView
            android:id="@+id/button_add_mode"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_custom_mode_add"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/custom_mode_add"
            android:textColor="@color/custom_mode_add_text"
            android:textSize="16sp" />
</LinearLayout>
