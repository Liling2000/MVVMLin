<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/color_008577</item>
        <item name="colorPrimaryDark">@color/color_00574b</item>
        <item name="colorAccent">@color/color_d81b60</item>
        <item name="android:windowBackground">@color/color_f7f9fb</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AppStartTheme" parent="AppTheme" />

    <style name="AppWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/anim_noop</item>
        <item name="android:activityOpenExitAnimation">@anim/anim_noop</item>
        <item name="android:activityCloseEnterAnimation">@anim/anim_noop</item>
        <item name="android:activityCloseExitAnimation">@anim/anim_noop</item>
    </style>

    <style name="PowerPortTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/selector_power_port_tab</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_757589</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ChargingModeTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_charge_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/color_404040</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CustomTimePreset">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_custom_time_preset</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_191c1e</item>
        <item name="android:textSize">@dimen/sp_13</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatisticsPortTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_55596a</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ScreenSettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="ScreenSettingIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
    </style>

    <style name="ScreenSettingTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_191c1e</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenSettingDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/color_454558</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BatteryInformationRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">65dp</item>
        <item name="left_text_size">15sp</item>
        <item name="right_text_size">15sp</item>
        <item name="left_text_color">@color/color_191c1e</item>
        <item name="right_text_color">@color/color_55596a</item>
    </style>
</resources>
