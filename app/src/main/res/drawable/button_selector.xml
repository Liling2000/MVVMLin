<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/dp10" />
            <solid android:color="@color/c_D45234" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/dp10" />
            <solid android:color="@color/c_E8E8E8" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="@dimen/dp10" />
            <gradient android:endColor="@color/c_F5CE55" android:startColor="@color/c_FCF150" />
        </shape>
    </item>
</selector>