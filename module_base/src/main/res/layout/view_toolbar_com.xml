<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="87dp">

    <ImageView
            android:id="@+id/iv_left_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_tit" />

    <ImageView
            android:id="@+id/iv_left_icon_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_left_icon"
            app:layout_constraintStart_toEndOf="@+id/iv_left_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_left_icon" />

    <TextView
            android:id="@+id/tv_left_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:textColor="@color/c_000000"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_right_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_right_icon"
            tools:text="左标题"
            tools:visibility="gone" />

    <TextView
            android:id="@+id/tv_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:textColor="@color/c_181a20"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <ImageView
            android:id="@+id/iv_second_right_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_left_icon"
            app:layout_constraintEnd_toStartOf="@+id/iv_right_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_left_icon"
            tools:visibility="visible" />

    <ImageView
            android:id="@+id/iv_right_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="19dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_left_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_left_icon"
            tools:visibility="visible" />

    <TextView
            android:id="@+id/tv_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="13dp"
            android:textColor="@color/c_a0a0ab"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_tit"
            tools:text="右标题"
            tools:visibility="visible" />

    <View
            android:id="@+id/title_bar_underline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/c_ebebeb"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>