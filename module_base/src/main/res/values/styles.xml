<resources>

    <!--NavigateTabBar-->
    <declare-styleable name="NavigateTabBar">
        <attr name="navigateTabTextColor" format="color|reference" />
        <attr name="navigateTabSelectedTextColor" format="color|reference" />
        <attr name="containerId" format="integer|reference" />
        <attr name="navigateTabTextSize" format="dimension|reference" />
    </declare-styleable>

    <declare-styleable name="ComToolBar">
        <attr name="tit_text" format="string" />
        <attr name="tit_size" format="dimension" />
        <attr name="tit_image" format="reference" />
        <attr name="tit_left_text" format="string" />
        <attr name="left_icon" />
        <attr name="right_icon" format="reference" />
        <attr name="show_line" format="boolean" />
    </declare-styleable>


    <declare-styleable name="SwitchButtonKotlin">
        <!-- 背景颜色（未选中） -->
        <attr name="sb_uncheckedColor" format="color" />
        <!-- 选中颜色 -->
        <attr name="sb_checkedColor" format="color" />
        <!-- Thumb 颜色 -->
        <attr name="sb_thumbColor" format="color" />
        <!-- 未选中时Thumb 颜色 -->
        <attr name="sb_un_thumbColor" format="color" />
        <!-- 圆角（默认 = 高度一半） -->
        <attr name="sb_radius" format="dimension" />
        <!-- 是否开启动画 -->
        <attr name="sb_enableEffect" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ContentWithUnitTextView">
        <attr name="tv_content_size" format="dimension" />
        <attr name="tv_content_color" format="color" />
        <attr name="tv_content" format="string" />
        <attr name="tv_unit_size" format="dimension" />
        <attr name="tv_unit_color" format="color" />
        <attr name="tv_unit" format="string" />
        <attr name="tv_show_unit_when_empty" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MyInformationView">
        <attr name="left_icon" format="reference" />
        <attr name="left_text" format="string|reference" />
        <attr name="left_text_color" format="color|reference" />
        <attr name="left_text_size" format="dimension|reference" />
        <attr name="left_sub_text" format="string|reference" />
        <attr name="left_sub_text_color" format="color|reference" />
        <attr name="left_sub_text_size" format="dimension|reference" />
        <attr name="right_text" format="string|reference" />
        <attr name="right_text_color" format="color|reference" />
        <attr name="right_text_size" format="dimension|reference" />
        <attr name="right_arrow_icon" format="reference" />
        <attr name="is_show_line" format="boolean" />
        <attr name="is_show_arrow_right" format="boolean" />
        <attr name="background" format="reference" />
    </declare-styleable>

    <declare-styleable name="CommonInformationView">
        <attr name="rv_backgroundColor" format="color" />
        <attr name="rv_backgroundPressColor" format="color" />
        <attr name="rv_cornerRadius" format="dimension" />
        <attr name="rv_cornerRadius_BL" format="dimension" />
        <attr name="rv_cornerRadius_BR" format="dimension" />
        <attr name="rv_cornerRadius_TL" format="dimension" />
        <attr name="rv_cornerRadius_TR" format="dimension" />
        <attr name="rv_isRadiusHalfHeight" format="boolean" />
        <attr name="rv_isRippleEnable" format="boolean" />
        <attr name="rv_isWidthHeightEqual" format="boolean" />
        <attr name="rv_strokeColor" format="color" />
        <attr name="rv_strokePressColor" format="color" />
        <attr name="rv_strokeWidth" format="dimension" />
        <attr name="rv_textPressColor" format="color" />

        <attr name="rv_arrowRightIcon" format="reference" />
        <attr name="rv_leftIcon" format="reference" />
        <attr name="rv_leftIconSize" format="dimension" />
        <attr name="rv_leftText" format="reference" />
        <attr name="rv_leftTextTip" format="reference" />
        <attr name="rv_rightText" format="reference" />
        <attr name="rv_leftTextColor" format="color" />
        <attr name="rv_leftTextTipColor" format="color" />
        <attr name="rv_rightTextColor" format="color" />
        <attr name="rv_leftTextSize" format="dimension" />
        <attr name="rv_leftTextTipSize" format="dimension" />
        <attr name="rv_rightTextSize" format="dimension" />
        <attr name="rv_isShowArrowRight" format="boolean" />
        <attr name="rv_isShowLine" format="boolean" />
        <attr name="rv_isShowHelpIcon" format="boolean" />
        <attr name="rv_isShowSwitchButton" format="boolean" />
        <attr name="rv_isShowCheckBox" format="boolean" />
        <attr name="rv_horizontal_margin" format="dimension" />
        <attr name="rv_vertical_margin" format="dimension" />
        <attr name="rv_rightTextMaxWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="WheelView">
        <!--文字大小-->
        <attr name="wv_textSize" format="dimension" />
        <!--是否自适应文字大小以完全显示过长的文字-->
        <attr name="wv_autoFitTextSize" format="boolean" />
        <!--自适应文字大小时最小缩放字体大小-->
        <attr name="wv_minTextSize" format="dimension" />
        <!--文字对齐方式-->
        <attr name="wv_textAlign" format="enum">
            <enum name="left" value="0" />
            <enum name="center" value="1" />
            <enum name="right" value="2" />
        </attr>
        <!--文本距离padding的外边距-->
        <attr name="wv_textPadding" format="dimension" />
        <attr name="wv_textPaddingLeft" format="dimension" />
        <attr name="wv_textPaddingRight" format="dimension" />
        <attr name="android:gravity" />
        <!--左右附加文本相关-->
        <attr name="wv_leftText" format="string" />
        <attr name="wv_rightText" format="string" />
        <attr name="wv_leftTextSize" format="dimension" />
        <attr name="wv_rightTextSize" format="dimension" />
        <attr name="wv_leftTextMarginRight" format="dimension" />
        <attr name="wv_rightTextMarginLeft" format="dimension" />
        <attr name="wv_leftTextColor" format="color" />
        <attr name="wv_rightTextColor" format="color" />
        <attr name="wv_leftTextGravity" format="enum">
            <enum name="center" value="0" />
            <enum name="top" value="1" />
            <enum name="bottom" value="2" />
        </attr>
        <attr name="wv_rightTextGravity" format="enum">
            <enum name="center" value="0" />
            <enum name="top" value="1" />
            <enum name="bottom" value="2" />
        </attr>
        <!--左右附加文本相关-->

        <!--未选中文字颜色-->
        <attr name="wv_normalTextColor" format="color" />
        <!--被选中的文字颜色-->
        <attr name="wv_selectedTextColor" format="color" />
        <!--行间距-->
        <attr name="wv_lineSpacing" format="dimension" />
        <!--选中的item字体是否需要加粗-->
        <attr name="wv_selectedTextFakeBold" format="boolean" />
        <!--可见item数-->
        <attr name="wv_visibleItems" format="integer" />
        <!--当前选中下标-->
        <attr name="wv_selectedPosition" format="integer" />
        <!--最大选中下标-->
        <attr name="wv_maxSelectedPosition" format="integer" />
        <!--最小选中下标-->
        <attr name="wv_minSelectedPosition" format="integer" />
        <!--是否循环滚动-->
        <attr name="wv_cyclic" format="boolean" />

        <!--是否显示分割线-->
        <attr name="wv_showDivider" format="boolean" />
        <!--分割线类型-->
        <attr name="wv_dividerType" format="enum">
            <enum name="fill" value="0" />
            <enum name="wrap" value="1" />
            <enum name="wrap_all" value="2" />
        </attr>
        <!--分割线颜色-->
        <attr name="wv_dividerColor" format="color" />
        <!--分割线高度-->
        <attr name="wv_dividerHeight" format="dimension" />
        <!--wrap类型下分割线内边距-->
        <attr name="wv_dividerPadding" format="dimension" />


        <!--是否是弯曲（3D）效果-->
        <attr name="wv_curved" format="boolean" />
        <!--弯曲（3D）效果左右圆弧偏移效果方向 可向指定方向偏移-->
        <attr name="wv_curvedArcDirection" format="enum">
            <enum name="left" value="0" />
            <enum name="center" value="1" />
            <enum name="right" value="2" />
        </attr>
        <!--弯曲（3D）效果左右圆弧偏移效果方向系数 偏移系数-->
        <attr name="wv_curvedArcDirectionFactor" format="float" />
        <!--选中后折射的偏移(弯曲（3D）效果和普通效果都适用) 与字体大小的比值，1为不偏移 越小偏移越明显-->
        <attr name="wv_refractRatio" format="float" />

        <!--是否绘制选中区域-->
        <attr name="wv_isShowCurtain" format="boolean" />
        <!--选中区域颜色-->
        <attr name="wv_curtainColor" format="color" />
        <!--选中区域/分割线上下偏移，通过移动分割线上下限制的位置来实现扩大/缩小显示区域-->
        <attr name="wv_dividerOffsetY" format="dimension" />
    </declare-styleable>

    <declare-styleable name="AbsRoundImageView">
        <attr name="riv_borderWidth" format="dimension|reference" />
        <attr name="riv_borderColor" format="color|reference" />
    </declare-styleable>

    <declare-styleable name="RoundImageView">
        <attr name="riv_radius" format="dimension|reference" />
        <attr name="riv_leftTopRadius" format="dimension|reference" />
        <attr name="riv_rightTopRadius" format="dimension|reference" />
        <attr name="riv_rightBottomRadius" format="dimension|reference" />
        <attr name="riv_leftBottomRadius" format="dimension|reference" />
    </declare-styleable>
</resources>
